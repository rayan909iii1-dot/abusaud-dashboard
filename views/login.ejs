<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>AbuSaud Store | تسجيل الدخول</title>
<meta property="og:type" content="website"><meta property="og:title" content="AbuSaud Store | لوحة تحكم البوتات"><meta property="og:description" content="لوحة تحكم متكاملة لإدارة وتشغيل البوتات بسهولة."><meta property="og:image" content="https://abusaud-dashboard-production.up.railway.app/images/banner.png"><meta property="og:url" content="https://abusaud-dashboard-production.up.railway.app/">
<style>
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap');
*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;background:#070b14;color:#fff;font-family:Cairo,Arial;overflow:hidden}body:before{content:"";position:fixed;width:500px;height:500px;border-radius:50%;background:#2563eb25;filter:blur(90px);top:-180px;right:-100px}.wrap{width:min(430px,92%);position:relative}.card{background:#0d1422ee;border:1px solid #243149;border-radius:24px;padding:34px;box-shadow:0 30px 90px #0008;backdrop-filter:blur(20px)}.logo{width:72px;height:72px;border-radius:20px;object-fit:cover;border:1px solid #334155;margin-bottom:20px}.eyebrow{font-size:10px;color:#60a5fa;font-weight:800}.title{font-size:28px;font-weight:800;margin-top:5px}.sub{color:#64748b;font-size:12px;margin:6px 0 28px}label{display:block;font-size:11px;color:#cbd5e1;font-weight:700;margin:0 0 7px}input{width:100%;padding:13px;border-radius:10px;border:1px solid #273449;background:#080d17;color:#fff;font-family:inherit;margin-bottom:16px;outline:0}input:focus{border-color:#3b82f6}.btn{width:100%;border:0;border-radius:10px;padding:13px;background:#2563eb;color:#fff;font-family:inherit;font-weight:800;cursor:pointer}.error{background:#ef444415;border:1px solid #ef444433;color:#f87171;border-radius:9px;padding:10px;font-size:11px;text-align:center;margin-bottom:15px}.register{text-align:center;color:#64748b;font-size:11px;margin-top:20px}.register a{color:#60a5fa;text-decoration:none;font-weight:800}
</style></head><body><div class="wrap"><div class="card"><img class="logo" src="/images/banner.png"><div class="eyebrow">ABUSAUD / STORE</div><div class="title">أهلاً بك من جديد</div><div class="sub">سجل دخولك للوصول إلى لوحة التحكم</div><% if(error){ %><div class="error"><%= error %></div><% } %><form action="/login" method="POST"><label>اسم المستخدم</label><input name="username" placeholder="اكتب اسم المستخدم" required><label>كلمة المرور</label><input type="password" name="password" placeholder="اكتب كلمة المرور" required><button class="btn">تسجيل الدخول</button></form><div class="register">ما عندك حساب؟ <a href="/register">إنشاء حساب</a></div></div></div></body></html>
