<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">

    <!-- ========================= -->
    <!-- معلومات الموقع -->
    <!-- ========================= -->

    <title>AbuSaud Store | لوحة تحكم البوتات</title>

    <meta name="description"
        content="لوحة تحكم AbuSaud Store لإدارة وتشغيل البوتات والخدمات بسهولة 24/7.">

    <!-- ========================= -->
    <!-- Discord / Open Graph -->
    <!-- ========================= -->

    <meta property="og:type" content="website">

    <meta property="og:title"
        content="AbuSaud Store | لوحة تحكم البوتات">

    <meta property="og:description"
        content="لوحة تحكم متكاملة لإدارة وتشغيل البوتات الخاصة بك بسهولة وعلى مدار الساعة.">

    <meta property="og:url"
        content="https://YOUR-DOMAIN.up.railway.app/">

    <meta property="og:image"
        content="https://YOUR-DOMAIN.up.railway.app/images/banner.png">

    <meta property="og:image:width"
        content="1536">

    <meta property="og:image:height"
        content="864">

    <meta property="og:image:alt"
        content="AbuSaud Store">

    <!-- لون الـ Embed -->
    <meta name="theme-color" content="#3b82f6">

    <!-- ========================= -->
    <!-- Twitter / Social Preview -->
    <!-- ========================= -->

    <meta name="twitter:card"
        content="summary_large_image">

    <meta name="twitter:title"
        content="AbuSaud Store | لوحة تحكم البوتات">

    <meta name="twitter:description"
        content="لوحة تحكم متكاملة لإدارة وتشغيل البوتات الخاصة بك بسهولة وعلى مدار الساعة.">

    <meta name="twitter:image"
        content="https://YOUR-DOMAIN.up.railway.app/images/banner.png">

    <!-- ========================= -->
    <!-- CSS -->
    <!-- ========================= -->

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Tahoma', sans-serif;
        }

        body {
            background: #0b0f19;
            color: #fff;
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        .sidebar {
            width: 260px;
            background: #111827;
            border-left: 1px solid #1f2937;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 20px;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 30px;
        }

        .sidebar-brand img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #3b82f6;
        }

        .sidebar-brand span {
            font-size: 16px;
            font-weight: bold;
            color: #fff;
        }

        .sidebar-menu {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 10px;
            flex-grow: 1;
        }

        .sidebar-menu a {
            color: #9ca3af;
            text-decoration: none;
            padding: 12px 15px;
            border-radius: 8px;
            transition: 0.3s;
            display: block;
            font-weight: bold;
            cursor: pointer;
        }

        .sidebar-menu a:hover,
        .sidebar-menu a.active {
            background: #1f2937;
            color: #fff;
        }

        .logout-btn {
            background: #ef4444;
            color: white;
            text-align: center;
            padding: 10px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            display: block;
        }

        .main-content {
            flex-grow: 1;
            overflow-y: auto;
            padding: 30px;
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        .online-text {
            color: #22c55e;
        }

        .offline-text {
            color: #ef4444;
        }

        .banner {
            width: 100%;
            height: 400px;
            border-radius: 15px;

            background-image: url('https://media.discordapp.net/attachments/1532884755698421861/1532890509096517682/ChatGPT_Image_1_2026_02_19_06_.png?ex=6a790b09&is=6a77b989&hm=53e531aab2cd4314c44c1aa99e062733872083f1f43bf65a3efc432a5f665239&=&format=webp&quality=lossless&width=1536&height=864');

            background-size: cover;
            background-position: center;
            position: relative;

            box-shadow:
                0 10px 25px rgba(0, 0, 0, 0.5);

            display: flex;
            align-items: flex-end;
            padding: 20px;
            flex-shrink: 0;
        }

        .banner::after {
            content: '';
            position: absolute;
            inset: 0;

            background:
                linear-gradient(
                    to top,
                    rgba(11, 15, 25, 0.9),
                    transparent
                );

            border-radius: 15px;
        }

        .banner-text {
            position: relative;
            z-index: 1;
            font-size: 22px;
            font-weight: bold;
            color: #fff;

            text-shadow:
                0 2px 4px rgba(0, 0, 0, 0.8);
        }

        .content-section {
            display: none;
            flex-direction: column;
            gap: 20px;
        }

        .content-section.active {
            display: flex;
        }

        .section-title {
            font-size: 22px;
            font-weight: bold;
            margin-bottom: 15px;
            border-bottom: 2px solid #1f2937;
            padding-bottom: 8px;
            color: #60a5fa;
        }

        .card {
            background: #111827;
            border: 1px solid #1f2937;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 15px;

            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .store-grid {
            display: grid;
            grid-template-columns:
                repeat(auto-fill, minmax(260px, 1fr));

            gap: 20px;
        }

        .store-card {
            background: #111827;
            border: 1px solid #1f2937;
            border-radius: 12px;
            padding: 20px;

            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 15px;
        }

        .badge {
            display: inline-block;
            background: #1e3a8a;
            color: #93c5fd;
            font-size: 12px;
            padding: 3px 8px;
            border-radius: 4px;
            margin-bottom: 5px;
            width: fit-content;
        }

        input,
        select {
            padding: 10px;
            margin: 5px 0 15px 0;
            border-radius: 6px;
            border: 1px solid #374151;
            background: #0b0f19;
            color: #fff;
            width: 100%;
        }

        .btn-action {
            padding: 8px 15px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
        }

        .start {
            background: #22c55e;
            color: white;
        }

        .stop {
            background: #ef4444;
            color: white;
        }

        .restart {
            background: #eab308;
            color: black;
        }

        .admin-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            background: #111827;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid #1f2937;
        }

        .admin-table th,
        .admin-table td {
            padding: 12px 15px;
            text-align: right;
            border-bottom: 1px solid #1f2937;
        }

        .admin-table th {
            background: #1f2937;
            color: #60a5fa;
        }
    </style>
</head>

<body>

    <!-- ========================= -->
    <!-- Sidebar -->
    <!-- ========================= -->

    <div class="sidebar">

        <div>

            <div class="sidebar-brand">

                <img
                    src="https://images-ext-1.discordapp.net/external/-7gcw8rPEjKrxvyw1Yh1g4kRakouCaAXYhU9gUd_jmQ/https/cdn.discordapp.com/icons/1516478520170123409/dad85d1c57cb29d7f988c35cfd8f7e8b.webp?format=webp"
                    alt="Logo"
                >

                <span>AbuSaud ˢᵀᴼᴿᴱ</span>

            </div>

            <ul class="sidebar-menu">

                <li>
                    <a
                        onclick="switchTab('dashboard', this)"
                        class="active"
                    >
                        📊 لوحة التحكم
                    </a>
                </li>

                <li>
                    <a
                        onclick="switchTab('my-bots', this)"
                    >
                        🤖 بوتاتي المتاحة
                    </a>
                </li>

                <li>
                    <a
                        onclick="switchTab('store', this)"
                    >
                        🛒 المتجر والأنواع
                    </a>
                </li>

                <% if (isAdmin) { %>

                    <li>
                        <a
                            onclick="switchTab('admin', this)"
                        >
                            👑 لوحة المشرف
                        </a>
                    </li>

                <% } %>

            </ul>

        </div>

        <div>

            <p
                style="
                    font-size: 13px;
                    color: #9ca3af;
                    margin-bottom: 10px;
                "
            >
                المستخدم:
                <%= currentUser %>
            </p>

            <a
                href="/logout"
                class="logout-btn"
            >
                تسجيل خروج 🚪
            </a>

        </div>

    </div>

    <!-- ========================= -->
    <!-- Main Content -->
    <!-- ========================= -->

    <div class="main-content">

        <!-- Banner -->

        <div class="banner">

            <div class="banner-text">
                🚀 أهلاً بك في متجرك الرسمي لإدارة وتشغيل البوتات 24/7
            </div>

        </div>


        <!-- ========================= -->
        <!-- Dashboard -->
        <!-- ========================= -->

        <div
            id="dashboard"
            class="content-section active"
        >

            <h3 class="section-title">
                📊 لوحة التحكم - إدارة بوتاتك
            </h3>

            <% if (bots.length === 0) { %>

                <p style="color: #9ca3af;">
                    لا توجد بوتات مضافة لحسابك حالياً.
                </p>

            <% } else { %>

                <% bots.forEach(bot => { %>

                    <div class="card">

                        <div>

                            <%
                                const isOnline =
                                    bot.status === 'online';

                                const statusText =
                                    isOnline
                                        ? '🟢 يعمل'
                                        : '🔴 متوقف';
                            %>

                            <h4
                                style="
                                    font-size: 18px;
                                    margin-bottom: 5px;
                                "
                            >
                                <%= bot.name %>

                                <span
                                    style="
                                        font-size: 12px;
                                        color: #9ca3af;
                                    "
                                >
                                    (<%= bot.script %>)
                                </span>
                            </h4>

                            <p>
                                الحالة:

                                <span
                                    class="<%= isOnline ? 'online-text' : 'offline-text' %>"
                                >
                                    <%= statusText %>
                                </span>
                            </p>

                        </div>

                        <div>

                            <form
                                action="/start/<%= bot.id %>"
                                method="POST"
                                style="display:inline;"
                            >

                                <button
                                    type="submit"
                                    class="btn-action start"
                                >
                                    تشغيل ▶️
                                </button>

                            </form>

                            <form
                                action="/stop/<%= bot.id %>"
                                method="POST"
                                style="display:inline;"
                            >

                                <button
                                    type="submit"
                                    class="btn-action stop"
                                >
                                    إيقاف ⏹️
                                </button>

                            </form>

                            <form
                                action="/restart/<%= bot.id %>"
                                method="POST"
                                style="display:inline;"
                            >

                                <button
                                    type="submit"
                                    class="btn-action restart"
                                >
                                    ريستارت 🔄
                                </button>

                            </form>

                        </div>

                    </div>

                <% }) %>

            <% } %>

        </div>


        <!-- ========================= -->
        <!-- My Bots -->
        <!-- ========================= -->

        <div
            id="my-bots"
            class="content-section"
        >

            <h3 class="section-title">
                🤖 بوتاتي المتاحة والمفعلة
            </h3>

            <% if (bots.length === 0) { %>

                <p style="color: #9ca3af;">
                    ليس لديك أي بوتات مفعلة حالياً.
                </p>

            <% } else { %>

                <div class="store-grid">

                    <% bots.forEach(bot => { %>

                        <div class="store-card">

                            <div>

                                <span class="badge">
                                    نوع السكربت:
                                    <%= bot.script %>
                                </span>

                                <h4
                                    style="
                                        font-size: 18px;
                                        margin: 10px 0;
                                    "
                                >
                                    <%= bot.name %>
                                </h4>

                                <p
                                    style="
                                        font-size: 13px;
                                        color: #9ca3af;
                                    "
                                >
                                    معرف البوت:
                                    <%= bot.id %>
                                </p>

                            </div>

                            <div>

                                <p style="margin-top: 10px;">

                                    الحالة:

                                    <span
                                        class="<%= bot.status === 'online' ? 'online-text' : 'offline-text' %>"
                                    >
                                        <%= bot.status === 'online'
                                            ? '🟢 يعمل'
                                            : '🔴 متوقف'
                                        %>
                                    </span>

                                </p>

                            </div>

                        </div>

                    <% }) %>

                </div>

            <% } %>

        </div>


        <!-- ========================= -->
        <!-- Store -->
        <!-- ========================= -->

        <div
            id="store"
            class="content-section"
        >

            <h3 class="section-title">
                🛒 متجر البوتات والخدمات المتاحة
            </h3>

            <div class="store-grid">

                <div class="store-card">

                    <div>

                        <span class="badge">
                            سكربت مميز
                        </span>

                        <h4
                            style="
                                font-size: 18px;
                                margin: 10px 0;
                            "
                        >
                            Welcome Bot (بوت الترحيب)
                        </h4>

                        <p
                            style="
                                font-size: 14px;
                                color: #9ca3af;
                            "
                        >
                            بوت ترحيب احترافي للأعضاء الجدد
                            مع تخصيص كامل للرسائل والصور واللوجو.
                        </p>

                    </div>

                    <button
                        class="btn-action start"
                        style="
                            width: 100%;
                            margin-top: 15px;
                        "
                        onclick="
                            switchTab(
                                'dashboard',
                                document.querySelectorAll(
                                    '.sidebar-menu a'
                                )[0]
                            )
                        "
                    >
                        إدارة البوتات ⚙️
                    </button>

                </div>

            </div>

        </div>


        <!-- ========================= -->
        <!-- Admin -->
        <!-- ========================= -->

        <% if (isAdmin) { %>

        <div
            id="admin"
            class="content-section"
        >

            <h3 class="section-title">
                👑 لوحة المشرف - التحكم الشامل
            </h3>


            <div
                style="
                    background: #111827;
                    padding: 20px;
                    border-radius: 12px;
                    border: 1px solid #1f2937;
                    margin-bottom: 20px;
                "
            >

                <h4
                    style="
                        margin-bottom: 15px;
                        color: #60a5fa;
                    "
                >
                    إضافة بوت جديد لأي مستخدم
                </h4>

                <form
                    action="/add-bot"
                    method="POST"
                >

                    <label>
                        معرف البوت (ID):
                    </label>

                    <input
                        type="text"
                        name="id"
                        required
                        placeholder="مثال: 1535393662920298597"
                    >


                    <label>
                        اسم البوت:
                    </label>

                    <input
                        type="text"
                        name="name"
                        required
                        placeholder="مثال: Welcome Bot"
                    >


                    <label>
                        توكن البوت (Token):
                    </label>

                    <input
                        type="text"
                        name="token"
                        required
                        placeholder="ضع التوكن هنا"
                    >


                    <label>
                        نوع السكربت:
                    </label>

                    <select name="script">

                        <% availableScripts.forEach(script => { %>

                            <option
                                value="<%= script.toLowerCase() %>"
                            >
                                <%= script %>
                            </option>

                        <% }) %>

                    </select>


                    <label>
                        صاحب البوت (اسم المستخدم):
                    </label>

                    <input
                        type="text"
                        name="owner"
                        required
                        placeholder="مثال: abusaud"
                    >


                    <button
                        type="submit"
                        class="btn-action start"
                        style="
                            width: 100%;
                            margin-top: 10px;
                        "
                    >
                        إضافة البوت للنظام 🚀
                    </button>

                </form>

            </div>


            <h4
                style="
                    margin-bottom: 10px;
                    color: #60a5fa;
                "
            >
                قائمة المستخدمين المسجلين:
            </h4>


            <table class="admin-table">

                <thead>

                    <tr>

                        <th>
                            اسم المستخدم
                        </th>

                        <th>
                            الصلاحية
                        </th>

                    </tr>

                </thead>

                <tbody>

                    <% allUsers.forEach(u => { %>

                        <tr>

                            <td>
                                <%= u.username %>
                            </td>

                            <td>
                                <%= u.isAdmin
                                    ? '👑 مشرف (Admin)'
                                    : '👤 مستخدم عادي'
                                %>
                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

        <% } %>

    </div>


    <!-- ========================= -->
    <!-- JavaScript -->
    <!-- ========================= -->

    <script>

        function switchTab(tabId, element) {

            document
                .querySelectorAll('.content-section')
                .forEach(sec => {
                    sec.classList.remove('active');
                });

            document
                .querySelectorAll('.sidebar-menu a')
                .forEach(btn => {
                    btn.classList.remove('active');
                });

            document
                .getElementById(tabId)
                .classList.add('active');

            element.classList.add('active');
        }

    </script>

</body>
</html>
