<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>لوحة التحكم | AbuSaud</title><link rel="stylesheet" href="/css/style.css"></head><body><div class="bg-orb orb-a"></div><div class="bg-orb orb-b"></div><div class="dashboard"><header class="topbar"><div class="brand"><div class="brand-mark">AS</div><div><b>AbuSaud</b><span>Bot Dashboard</span></div></div><div class="top-actions"><span class="user-pill">👤 <%= currentUser %><% if (isAdmin) { %> · Admin<% } %></span><a class="btn ghost small" href="/logout">تسجيل الخروج</a></div></header><section class="hero"><div><span class="eyebrow">DISCORD MANAGEMENT</span><h1>لوحة تحكم البوتات</h1><p>شغّل بوتاتك، أوقفها، وتابع حالتها من مكان واحد.</p></div><div class="hero-stat"><strong><%= bots.length %></strong><span>بوت</span></div></section><div class="grid stats"><div class="stat"><span>البوتات</span><b><%= bots.length %></b></div><div class="stat"><span>تعمل</span><b><%= bots.filter(b => b.status === 'يعمل').length %></b></div><div class="stat"><span>متوقفة</span><b><%= bots.filter(b => b.status !== 'يعمل').length %></b></div><div class="stat"><span>الحساب</span><b><%= isAdmin ? 'Admin' : 'User' %></b></div></div><% if (isAdmin) { %><section class="panel"><div class="panel-head"><div><h2>إضافة بوت</h2><p class="muted">أضف البوت واربطه بحساب مستخدم.</p></div><span class="badge">ADMIN</span></div><form class="add-form" method="post" action="/add-bot"><input name="name" placeholder="اسم البوت" required><input name="token" type="password" placeholder="Bot Token" required><select name="type" required><option value="">نوع البوت</option><% availableScripts.forEach(script => { %><option value="<%= script %>"><%= script %></option><% }) %></select><select name="owner" required><option value="">مالك البوت</option><% allUsers.forEach(user => { %><option value="<%= user.username %>"><%= user.username %></option><% }) %></select><button class="btn primary" type="submit">+ إضافة البوت</button></form></section><% } %><section class="panel"><div class="panel-head"><div><h2>بوتاتك</h2><p class="muted">التحكم بالحالة مباشرة.</p></div></div><% if (!bots.length) { %><div class="empty"><div class="empty-icon">🤖</div><h3>لا توجد بوتات</h3><p>أضف أول بوت من لوحة الإدارة.</p></div><% } else { %><div class="bot-grid"><% bots.forEach(bot => { %><article class="bot-card"><div class="bot-head"><div class="bot-icon">🤖</div><div><h3><%= bot.name %></h3><span><%= bot.type %> · <%= bot.owner %></span></div><span class="status <%= bot.status === 'يعمل' ? 'online' : 'offline' %>"><i></i><%= bot.status || 'متوقف' %></span></div><div class="bot-meta"><span>ID</span><code><%= bot.id %></code></div><div class="bot-actions"><button class="btn primary" data-action="start" data-id="<%= bot.id %>" <%= bot.status === 'يعمل' ? 'disabled' : '' %>>تشغيل</button><button class="btn danger" data-action="stop" data-id="<%= bot.id %>" <%= bot.status !== 'يعمل' ? 'disabled' : '' %>>إيقاف</button></div></article><% }) %></div><% } %></section><footer>AbuSaud Dashboard · <a href="/health">Health</a></footer></div><div id="toast" class="toast"></div><script src="/js/app.js"></script></body></html>
