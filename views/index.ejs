<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>AbuSaud Store | Dashboard</title>
<meta property="og:type" content="website">
<meta property="og:title" content="AbuSaud Store | لوحة تحكم البوتات">
<meta property="og:description" content="لوحة تحكم متكاملة لإدارة وتشغيل البوتات بسهولة.">
<meta property="og:image" content="https://abusaud-dashboard-production.up.railway.app/images/banner.png">
<meta property="og:url" content="https://abusaud-dashboard-production.up.railway.app/">
<style>
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap');
*{box-sizing:border-box;margin:0;padding:0}body{font-family:Cairo,Arial,sans-serif;background:#070b14;color:#f8fafc;min-height:100vh}
body:before{content:"";position:fixed;inset:0;background:radial-gradient(circle at 80% 0,#1d4ed81c,transparent 30%),radial-gradient(circle at 10% 80%,#7c3aed12,transparent 30%);pointer-events:none}
.layout{display:flex;min-height:100vh}.side{width:260px;background:#0b101bdf;border-left:1px solid #1e293b;padding:24px 16px;position:fixed;right:0;top:0;bottom:0;z-index:5;backdrop-filter:blur(16px)}
.brand{display:flex;align-items:center;gap:12px;padding:8px 10px 28px;border-bottom:1px solid #1e293b;margin-bottom:22px}.brand img{width:45px;height:45px;border-radius:14px;object-fit:cover;border:1px solid #334155}.brand b{font-size:17px}.brand small{display:block;color:#64748b;font-size:10px;margin-top:2px}
.nav{display:grid;gap:7px}.nav a{color:#94a3b8;text-decoration:none;padding:12px 14px;border-radius:11px;display:block;font-size:13px;font-weight:700;cursor:pointer;transition:.2s}.nav a:hover,.nav a.active{background:#172033;color:#fff;box-shadow:inset -3px 0 #3b82f6}
.user{position:absolute;bottom:18px;left:16px;right:16px;background:#111827;border:1px solid #1f2937;border-radius:14px;padding:12px}.user strong{display:block;font-size:12px}.user span{font-size:10px;color:#64748b}.logout{display:block;text-align:center;background:#ef444415;color:#f87171;text-decoration:none;padding:8px;border-radius:8px;margin-top:10px;font-size:11px;font-weight:700}
.main{margin-right:260px;width:calc(100% - 260px);padding:28px 34px 50px}.top{display:flex;align-items:center;justify-content:space-between;margin-bottom:25px}.eyebrow{color:#60a5fa;font-size:11px;font-weight:800}.title{font-size:27px;font-weight:800;margin-top:3px}.date{color:#64748b;font-size:11px}
.hero{min-height:250px;border:1px solid #263246;border-radius:22px;overflow:hidden;position:relative;background:url('/images/banner.png') center/cover;box-shadow:0 20px 70px #0006}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#070b14f5 0%,#070b1480 55%,#070b1410)}.hero-content{position:relative;z-index:1;padding:45px;max-width:620px}.hero h2{font-size:30px;line-height:1.35}.hero p{color:#b6c2d4;font-size:13px;margin:10px 0 20px}.pill{display:inline-flex;gap:7px;align-items:center;background:#2563eb20;border:1px solid #3b82f655;color:#93c5fd;padding:7px 11px;border-radius:99px;font-size:11px;font-weight:700}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:20px 0}.stat{background:#0d1422;border:1px solid #1e293b;border-radius:16px;padding:18px}.stat small{color:#64748b;font-size:10px}.stat strong{display:block;font-size:25px;margin-top:5px}.stat i{font-style:normal;color:#22c55e;font-size:10px}
.section{display:none}.section.active{display:block}.section-head{display:flex;align-items:center;justify-content:space-between;margin:26px 0 13px}.section-head h3{font-size:17px}.muted{color:#64748b;font-size:11px}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px}.card{background:#0d1422;border:1px solid #1e293b;border-radius:16px;padding:18px;transition:.2s}.card:hover{transform:translateY(-2px);border-color:#334155}.bot-top{display:flex;align-items:center;gap:12px}.bot-icon{width:45px;height:45px;border-radius:13px;background:#172033;display:grid;place-items:center;font-size:22px}.bot-name{font-weight:800;font-size:14px}.tag{font-size:9px;color:#60a5fa;background:#2563eb15;padding:3px 7px;border-radius:6px}.status{margin:17px 0;padding:9px 11px;background:#080d17;border-radius:9px;color:#94a3b8;font-size:11px}.online{color:#4ade80}.offline{color:#f87171}.actions{display:flex;gap:7px}.btn{border:0;border-radius:8px;padding:9px 10px;font-family:inherit;font-size:10px;font-weight:800;cursor:pointer;flex:1}.start{background:#22c55e;color:#06120a}.stop{background:#ef4444;color:#fff}.restart{background:#eab308;color:#171000}.store{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:14px}.price{font-size:22px;font-weight:800;margin:15px 0}.price span{font-size:10px;color:#64748b}.admin-box{background:#0d1422;border:1px solid #1e293b;border-radius:16px;padding:20px;margin-bottom:15px}.admin-box input,.admin-box select{width:100%;background:#080d17;border:1px solid #273449;color:#fff;padding:11px;border-radius:9px;margin:6px 0 13px;font-family:inherit}.blue{background:#2563eb;color:white;width:100%}.table{width:100%;border-collapse:collapse}.table th,.table td{padding:12px;text-align:right;border-bottom:1px solid #1e293b;font-size:11px}.table th{color:#60a5fa}
@media(max-width:900px){.side{width:220px}.main{margin-right:220px;width:calc(100% - 220px);padding:20px}.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.side{position:relative;width:100%;height:auto}.layout{display:block}.user{position:static;margin-top:25px}.main{margin:0;width:100%;padding:16px}.hero-content{padding:28px}.hero h2{font-size:23px}.grid{grid-template-columns:1fr 1fr}.top{display:block}.date{margin-top:5px}}
</style>
</head>
<body>
<div class="layout">
<aside class="side">
<div class="brand"><img src="/images/banner.png"><div><b>AbuSaud STORE</b><small>BOT MANAGEMENT</small></div></div>
<nav class="nav">
<a class="active" onclick="tab('dashboard',this)">◈ لوحة التحكم</a>
<a onclick="tab('my-bots',this)">◉ بوتاتي</a>
<a onclick="tab('store',this)">◆ المتجر</a>
<% if(isAdmin){ %><a onclick="tab('admin',this)">♛ لوحة المشرف</a><% } %>
</nav>
<div class="user"><strong><%= currentUser %></strong><span>حساب مسجل في النظام</span><a class="logout" href="/logout">تسجيل الخروج</a></div>
</aside>
<main class="main">
<div class="top"><div><div class="eyebrow">ABUSAUD / CONTROL CENTER</div><div class="title">مرحباً، <%= currentUser %> 👋</div></div><div class="date">لوحة التحكم الخاصة بك</div></div>

<section id="dashboard" class="section active">
<div class="hero"><div class="hero-content"><span class="pill">● النظام يعمل بشكل طبيعي</span><h2>إدارة بوتاتك<br>من مكان واحد.</h2><p>تحكم في البوتات والخدمات الخاصة بك بسهولة، وتابع حالتها من لوحة واحدة.</p></div></div>
<div class="grid">
<div class="stat"><small>إجمالي البوتات</small><strong><%= bots.length %></strong><i>● متصل بالنظام</i></div>
<div class="stat"><small>البوتات المتصلة</small><strong><%= bots.filter(b=>b.status==='online').length %></strong><i>● Online</i></div>
<div class="stat"><small>الخدمات المتاحة</small><strong><%= availableScripts.length %></strong><i>● جاهزة</i></div>
<div class="stat"><small>صلاحية الحساب</small><strong><%= isAdmin ? 'Admin' : 'User' %></strong><i>● نشطة</i></div>
</div>
<div class="section-head"><h3>البوتات الأخيرة</h3><span class="muted">إدارة سريعة</span></div>
<div class="cards">
<% if(bots.length===0){ %><div class="card"><p class="muted">لا توجد بوتات مضافة لحسابك حالياً.</p></div><% } %>
<% bots.slice(0,6).forEach(bot=>{ %>
<div class="card"><div class="bot-top"><div class="bot-icon">🤖</div><div><div class="bot-name"><%= bot.name || 'Bot' %></div><span class="tag"><%= bot.script || 'Bot' %></span></div></div>
<div class="status">الحالة: <b class="<%= bot.status==='online'?'online':'offline' %>"><%= bot.status==='online'?'● يعمل':'● متوقف' %></b></div>
<div class="actions"><form action="/start/<%= bot.id %>" method="POST" style="flex:1"><button class="btn start">تشغيل</button></form><form action="/stop/<%= bot.id %>" method="POST" style="flex:1"><button class="btn stop">إيقاف</button></form><form action="/restart/<%= bot.id %>" method="POST" style="flex:1"><button class="btn restart">ريستارت</button></form></div></div>
<% }) %></div>
</section>

<section id="my-bots" class="section"><div class="section-head"><h3>بوتاتي</h3><span class="muted">جميع البوتات المرتبطة بحسابك</span></div><div class="cards">
<% if(bots.length===0){ %><div class="card"><p class="muted">لا توجد بوتات حالياً.</p></div><% } %>
<% bots.forEach(bot=>{ %><div class="card"><div class="bot-top"><div class="bot-icon">🤖</div><div><div class="bot-name"><%= bot.name || 'Bot' %></div><span class="tag"><%= bot.script || 'Bot' %></span></div></div><div class="status">ID: <%= bot.id || '-' %><br>الحالة: <b class="<%= bot.status==='online'?'online':'offline' %>"><%= bot.status==='online'?'● يعمل':'● متوقف' %></b></div></div><% }) %>
</div></section>

<section id="store" class="section"><div class="section-head"><h3>المتجر</h3><span class="muted">الخدمات المتاحة</span></div><div class="store">
<% availableScripts.forEach((script,i)=>{ %><div class="card"><span class="tag">SERVICE <%= i+1 %></span><div class="bot-name" style="margin-top:12px"><%= script %> Bot</div><p class="muted" style="margin-top:8px">خدمة احترافية قابلة للإدارة من لوحة التحكم.</p><div class="price">قريباً <span>ر.س</span></div><button class="btn blue">عرض الخدمة</button></div><% }) %>
</div></section>

<% if(isAdmin){ %>
<section id="admin" class="section"><div class="section-head"><h3>لوحة المشرف</h3><span class="muted">إدارة النظام</span></div>
<div class="admin-box"><h3 style="margin-bottom:15px">إضافة بوت جديد</h3><form action="/add-bot" method="POST">
<input name="id" placeholder="معرف البوت" required><input name="name" placeholder="اسم البوت" required><input name="token" placeholder="توكن البوت" required><select name="script"><% availableScripts.forEach(s=>{ %><option value="<%= s.toLowerCase() %>"><%= s %></option><% }) %></select><input name="owner" placeholder="اسم صاحب البوت" required><button class="btn blue" type="submit">إضافة البوت للنظام</button>
</form></div>
<div class="admin-box"><h3 style="margin-bottom:12px">المستخدمون</h3><table class="table"><thead><tr><th>المستخدم</th><th>الصلاحية</th></tr></thead><tbody><% allUsers.forEach(u=>{ %><tr><td><%= u.username %></td><td><%= u.isAdmin?'♛ Admin':'User' %></td></tr><% }) %></tbody></table></div>
</section>
<% } %>
</main>
</div>
<script>
function tab(id,el){document.querySelectorAll('.section').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.nav a').forEach(x=>x.classList.remove('active'));document.getElementById(id).classList.add('active');el.classList.add('active')}
</script>
</body>
</html>
