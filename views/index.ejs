<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>AbuSaud Store | تسجيل الدخول</title>


    <!-- ========================= -->
    <!-- Discord / Open Graph -->
    <!-- ========================= -->

    <meta
        property="og:type"
        content="website"
    >

    <meta
        property="og:title"
        content="AbuSaud Store | لوحة تحكم البوتات"
    >

    <meta
        property="og:description"
        content="لوحة تحكم متكاملة لإدارة وتشغيل البوتات الخاصة بك بسهولة وعلى مدار الساعة."
    >

    <meta
        property="og:image"
        content="https://abusaud-dashboard-production.up.railway.app/images/banner.png"
    >

    <meta
        property="og:url"
        content="https://abusaud-dashboard-production.up.railway.app/"
    >

    <meta
        property="og:site_name"
        content="AbuSaud Store"
    >


    <!-- ========================= -->
    <!-- Twitter -->
    <!-- ========================= -->

    <meta
        name="twitter:card"
        content="summary_large_image"
    >

    <meta
        name="twitter:title"
        content="AbuSaud Store | لوحة تحكم البوتات"
    >

    <meta
        name="twitter:description"
        content="لوحة تحكم متكاملة لإدارة وتشغيل البوتات الخاصة بك بسهولة وعلى مدار الساعة."
    >

    <meta
        name="twitter:image"
        content="https://abusaud-dashboard-production.up.railway.app/images/banner.png"
    >


    <!-- ========================= -->
    <!-- CSS -->
    <!-- ========================= -->

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;

            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            background:
                radial-gradient(
                    circle at top,
                    #172033 0%,
                    #0b0f19 45%,
                    #070a10 100%
                );

            font-family:
                Arial,
                Tahoma,
                sans-serif;

            color: white;
        }


        .login-container {

            width: 100%;
            max-width: 430px;

            padding: 20px;
        }


        .login-card {

            background: rgba(
                17,
                24,
                39,
                0.95
            );

            border: 1px solid #1f2937;

            border-radius: 18px;

            padding: 35px;

            box-shadow:
                0 20px 60px
                rgba(0, 0, 0, 0.45);
        }


        .logo {

            width: 90px;
            height: 90px;

            object-fit: cover;

            display: block;

            margin:
                0 auto 20px;

            border-radius: 50%;

            border:
                2px solid #374151;
        }


        h1 {

            text-align: center;

            margin:
                0 0 8px;

            font-size: 26px;
        }


        .subtitle {

            text-align: center;

            color: #9ca3af;

            font-size: 14px;

            margin-bottom: 30px;
        }


        label {

            display: block;

            margin-bottom: 8px;

            color: #d1d5db;

            font-size: 14px;

            font-weight: bold;
        }


        input {

            width: 100%;

            padding: 13px 14px;

            margin-bottom: 18px;

            border-radius: 9px;

            border:
                1px solid #374151;

            background: #0b0f19;

            color: white;

            outline: none;

            font-size: 14px;

            transition:
                border-color 0.2s,
                box-shadow 0.2s;
        }


        input:focus {

            border-color: #60a5fa;

            box-shadow:
                0 0 0 3px
                rgba(
                    96,
                    165,
                    250,
                    0.12
                );
        }


        .login-button {

            width: 100%;

            padding: 13px;

            border: none;

            border-radius: 9px;

            background:
                linear-gradient(
                    135deg,
                    #2563eb,
                    #3b82f6
                );

            color: white;

            font-size: 15px;

            font-weight: bold;

            cursor: pointer;

            transition:
                transform 0.2s,
                opacity 0.2s;
        }


        .login-button:hover {

            opacity: 0.9;

            transform:
                translateY(-1px);
        }


        .error {

            background:
                rgba(
                    239,
                    68,
                    68,
                    0.12
                );

            border:
                1px solid
                rgba(
                    239,
                    68,
                    68,
                    0.3
                );

            color: #f87171;

            padding: 12px;

            border-radius: 8px;

            margin-bottom: 20px;

            text-align: center;

            font-size: 14px;
        }


        .register {

            text-align: center;

            margin-top: 22px;

            color: #9ca3af;

            font-size: 14px;
        }


        .register a {

            color: #60a5fa;

            text-decoration: none;

            font-weight: bold;
        }


        .register a:hover {

            text-decoration: underline;
        }


        .footer {

            text-align: center;

            color: #6b7280;

            font-size: 12px;

            margin-top: 20px;
        }

    </style>

</head>


<body>


    <div class="login-container">

        <div class="login-card">


            <!-- الشعار -->

            <img
                class="logo"
                src="/images/banner.png"
                alt="AbuSaud Store"
            >


            <h1>
                AbuSaud Store
            </h1>


            <div class="subtitle">

                لوحة تحكم البوتات

            </div>


            <!-- رسالة الخطأ -->

            <% if (error) { %>

                <div class="error">

                    <%= error %>

                </div>

            <% } %>


            <!-- تسجيل الدخول -->

            <form
                action="/login"
                method="POST"
            >


                <label for="username">

                    اسم المستخدم

                </label>


                <input
                    id="username"
                    type="text"
                    name="username"
                    placeholder="اكتب اسم المستخدم"
                    required
                    autocomplete="username"
                >


                <label for="password">

                    كلمة المرور

                </label>


                <input
                    id="password"
                    type="password"
                    name="password"
                    placeholder="اكتب كلمة المرور"
                    required
                    autocomplete="current-password"
                >


                <button
                    class="login-button"
                    type="submit"
                >

                    تسجيل الدخول

                </button>


            </form>


            <div class="register">

                ما عندك حساب؟

                <a href="/register">

                    إنشاء حساب

                </a>

            </div>


        </div>


        <div class="footer">

            AbuSaud Store © 2026

        </div>

    </div>


</body>

</html>
