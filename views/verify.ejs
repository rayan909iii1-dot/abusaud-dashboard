<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>تأكيد البريد | AbuSaud</title><link rel="stylesheet" href="/css/style.css"></head><body><div class="bg-orb orb-a"></div><div class="bg-orb orb-b"></div><main class="auth-wrap"><section class="auth-card"><div class="brand"><div class="brand-mark">AS</div><div><b>AbuSaud</b><span>Bot Dashboard</span></div></div><h1>تأكيد البريد</h1><p class="muted">أرسلنا كوداً من 6 أرقام إلى <strong><%= email %></strong>.</p><% if (error) { %><div class="alert <%= typeof success !== 'undefined' && success ? 'success' : 'error' %>"><%= error %></div><% } %><form method="post" action="/verify-email"><label>كود التحقق<input name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autofocus></label><button class="btn primary" type="submit">تأكيد</button></form><form method="post" action="/resend-verification" class="mt"><button class="btn ghost" type="submit">إرسال كود جديد</button></form><div class="switch"><a href="/register">العودة للتسجيل</a></div></section></main></body></html>
