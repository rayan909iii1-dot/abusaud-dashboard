<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>AbuSaud Store | تأكيد البريد</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap');
*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;background:#070b14;color:#fff;font-family:Cairo,Arial}body:before{content:"";position:fixed;width:500px;height:500px;border-radius:50%;background:#2563eb25;filter:blur(90px);top:-180px;right:-100px}.wrap{width:min(430px,92%)}.card{background:#0d1422ee;border:1px solid #243149;border-radius:24px;padding:34px;box-shadow:0 30px 90px #0008;text-align:center}.logo{width:65px;height:65px;border-radius:18px;object-fit:cover;border:1px solid #334155;margin-bottom:18px}.eyebrow{font-size:10px;color:#60a5fa;font-weight:800}.title{font-size:27px;font-weight:800;margin-top:4px}.sub{color:#64748b;font-size:12px;line-height:1.9;margin:7px 0 24px}.email{color:#cbd5e1;font-weight:800}.code{width:100%;padding:16px;border-radius:12px;border:1px solid #273449;background:#080d17;color:#fff;font-size:27px;text-align:center;letter-spacing:10px;outline:0;font-weight:800}.code:focus{border-color:#3b82f6}.btn{width:100%;border:0;border-radius:10px;padding:13px;background:#2563eb;color:#fff;font-family:inherit;font-weight:800;cursor:pointer;margin-top:14px}.secondary{background:#172033;color:#cbd5e1}.error{background:#ef444415;border:1px solid #ef444433;color:#f87171;border-radius:9px;padding:10px;font-size:11px;text-align:center;margin-bottom:15px}.success{background:#22c55e15;border:1px solid #22c55e33;color:#4ade80;border-radius:9px;padding:10px;font-size:11px;text-align:center;margin-bottom:15px}
</style>
</head>
<body>
<div class="wrap"><div class="card">
<img class="logo" src="/images/banner.png">
<div class="eyebrow">ABUSAUD / VERIFICATION</div>
<div class="title">تأكيد البريد الإلكتروني</div>
<div class="sub">أرسلنا كود مكوّن من 6 أرقام إلى<br><span class="email"><%= email %></span></div>

<% if(error){ %>
<div class="<%= typeof success !== 'undefined' && success ? 'success' : 'error' %>"><%= error %></div>
<% } %>

<form action="/verify-email" method="POST">
<input class="code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" minlength="6" placeholder="000000" required>
<button class="btn" type="submit">تأكيد البريد وإنشاء الحساب</button>
</form>

<form action="/resend-verification" method="POST">
<button class="btn secondary" type="submit">إعادة إرسال الكود</button>
</form>
</div></div>
<script>
document.querySelector('.code').addEventListener('input', function(){
  this.value=this.value.replace(/\D/g,'').slice(0,6);
});
</script>
</body>
</html>
